<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd = macOS's built-in scheduler. This file tells it:
  "at 08:00 and 18:00, run the summary with --live, from the project folder".
  If the Mac is asleep at that time, launchd runs it as soon as the Mac wakes.
  Install:   cp this file to ~/Library/LaunchAgents/ and `launchctl load` it (see README steps).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sidrianchan.email-organiser.digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>email_organiser.digest</string>
        <string>--live</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sid/projects/email-organiser</string>

    <!-- launchd starts with an almost empty PATH; this lets the script find `claude`. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/sid/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- Everything the run prints goes here (data/ is git-ignored). -->
    <key>StandardOutPath</key>
    <string>/Users/sid/projects/email-organiser/data/logs/digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sid/projects/email-organiser/data/logs/digest.log</string>
</dict>
</plist>
